# RentCar Uzbekistan — frontend configuration.
# Only VITE_* variables are exposed to the browser. Never put API secrets here:
# anything prefixed with VITE_ is bundled into public JavaScript.

# Base URL of a future booking/availability backend (leave empty to use the
# bundled reference data layer). When set, the app calls `${VITE_API_BASE_URL}/...`
# through src/services/api.ts. Provider API keys must stay on that backend.
VITE_API_BASE_URL=

# Map tile server (OpenStreetMap standard tiles by default). If you deploy at
# scale, switch to a tile provider whose usage policy fits your traffic.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Set to "false" to disable runtime loading of extra photos from the
# Wikimedia Commons API (pinned photos still load).
VITE_ENABLE_COMMONS_GALLERY=true
